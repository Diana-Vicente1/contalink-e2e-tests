    {
      "name": "07-GET invoices - 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has invoices and pagination\", function () {",
              "  const json = pm.response.json();",
              "",
              "  pm.expect(json).to.have.property(\"invoices\");",
              "  pm.expect(json).to.have.property(\"pagination\");",
              "});",
              "",
              "pm.test(\"Invoices is an array\", function () {",
              "  const json = pm.response.json();",
              "",
              "  pm.expect(json.invoices).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Invoices list can be empty or non-empty\", function () {",
              "  const json = pm.response.json();",
              "",
              "  pm.expect(json.invoices.length).to.be.at.least(0);",
              "});",
              "",
              "pm.test(\"Pagination has expected fields\", function () {",
              "  const json = pm.response.json();",
              "",
              "  pm.expect(json.pagination).to.have.property(\"totalPages\");",
              "  pm.expect(json.pagination).to.have.property(\"currentPage\");",
              "  pm.expect(json.pagination).to.have.property(\"nextPage\");",
              "  pm.expect(json.pagination).to.have.property(\"prevPage\");",
              "});",
              "",
              "pm.test(\"If invoices list is not empty, invoice has expected fields\", function () {",
              "  const json = pm.response.json();",
              "",
              "  if (json.invoices.length > 0) {",
              "    pm.expect(json.invoices[0]).to.have.property(\"id\");",
              "    pm.expect(json.invoices[0]).to.have.property(\"invoiceNumber\");",
              "    pm.expect(json.invoices[0]).to.have.property(\"total\");",
              "    pm.expect(json.invoices[0]).to.have.property(\"invoiceDate\");",
              "    pm.expect(json.invoices[0]).to.have.property(\"status\");",
              "    pm.expect(json.invoices[0]).to.have.property(\"active\");",
              "  }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
