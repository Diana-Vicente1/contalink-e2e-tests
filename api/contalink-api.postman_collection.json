              "  pm.expect(json.total).to.eql(2500.75);",
              "  pm.expect(json.status).to.eql(\"Pagado\");",
              "  pm.expect(json.invoiceNumber).to.include(\"-PUT\");",
              "",
              "  pm.environment.set(\"invoiceNumber\", json.invoiceNumber);",
              "});"
