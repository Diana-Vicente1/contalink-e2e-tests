  "item": [
    {
      "name": "01-POST invoice - 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains invoice id\", function () {",
              "  const json = pm.response.json();",
              "",
              "  pm.expect(json).to.have.property(\"id\");",
              "  pm.expect(json.id).to.be.a(\"number\");",
              "",
              "  pm.environment.set(\"invoiceId\", json.id);",
              "  pm.environment.set(\"invoiceNumber\", json.invoiceNumber);",
              "});",
              "",
              "pm.test(\"Invoice data is correct\", function () {",
              "  const json = pm.response.json();",
              "",
              "  pm.expect(json.invoiceNumber).to.include(\"API-DVD-\");",
              "  pm.expect(json.total).to.eql(600.9);",
              "  pm.expect(json.status).to.eql(\"Pendiente\");",
              "  pm.expect(json.active).to.eql(true);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"invoice_number\": \"API-DVD-{{$timestamp}}\",\n    \"total\": 600.9,\n    \"invoice_date\": \"16/05/2026 8:20 PM\",\n    \"status\": \"Pendiente\",\n    \"active\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/V1/invoices",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "V1",
            "invoices"
          ]
        }
      },
      "response": []
    },
