              "  pm.expect(json.id).to.eql(Number(pm.environment.get(\"invoiceId\")));",
              "});",
              "",
              "pm.test(\"Invoice number matches the created invoice\", function () {",
              "  const json = pm.response.json();",
              "",
              "  pm.expect(json).to.have.property(\"invoiceNumber\");",
              "  pm.expect(json.invoiceNumber).to.eql(pm.environment.get(\"invoiceNumber\"));",
              "});",
              "",
              "pm.test(\"Invoice response has expected fields\", function () {",
              "  const json = pm.response.json();",
              "",
              "  pm.expect(json).to.have.property(\"id\");",
              "  pm.expect(json).to.have.property(\"invoiceNumber\");",
              "  pm.expect(json).to.have.property(\"total\");",
              "  pm.expect(json).to.have.property(\"invoiceDate\");",
              "  pm.expect(json).to.have.property(\"status\");",
              "  pm.expect(json).to.have.property(\"active\");",
              "});"
